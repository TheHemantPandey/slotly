# Slotly Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# Do NOT commit actual secrets, API keys, or production credentials to version control.

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Database Configuration (Neon Serverless PostgreSQL with Prisma)
# -----------------------------------------------------------------------------
# 1. DATABASE_URL: Neon Pooled Connection String (Port 5432 or 6543)
#    In the Neon Console: Select your project -> "Connection Details" -> Enable "Pooled connection" checkbox.
#    Format: postgresql://<user>:<password>@<endpoint-id>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/slotly?sslmode=require"

# 2. DIRECT_URL: Neon Direct Connection String (Non-pooled)
#    In the Neon Console: Disable the "Pooled connection" checkbox to get the direct endpoint.
#    Used by Prisma CLI for migrations to acquire database advisory locks without pooler interference.
#    Format: postgresql://<user>:<password>@<endpoint-id>.<region>.aws.neon.tech/<dbname>?sslmode=require
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/slotly?sslmode=require"

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - Shared Distributed Rate Limiting)
# -----------------------------------------------------------------------------
# If configured, rate limits are atomically synchronized across all serverless/container instances.
# If omitted or unconfigured, Slotly gracefully falls back to a resilient in-memory sliding window store.
# Local Docker / VPS: redis://localhost:6379 or redis://redis:6379
# Cloud / Upstash / AWS: rediss://default:<password>@<host>:<port>
REDIS_URL="rediss://default:gXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@comic-vervet-93700.upstash.io:6379"

# -----------------------------------------------------------------------------
# Docker Compose Local Services (Optional)
# -----------------------------------------------------------------------------
# When running `docker compose up`, local postgres and redis containers use these values:
# POSTGRES_USER=""
# POSTGRES_PASSWORD=""
# POSTGRES_DB=""
# POSTGRES_PORT=
# REDIS_PORT=

# -----------------------------------------------------------------------------
# Admin Authentication & Security
# -----------------------------------------------------------------------------
# Admin email for dashboard authorization
ADMIN_EMAIL=""

# Secure PBKDF2 password hash (format: salt_hex:hash_hex).
# Generate using: npm run admin:hash
ADMIN_PASSWORD_HASH=""

# Cryptographically random 64-character hex string for signing admin session cookies.
# Generate using: openssl rand -hex 32
ADMIN_SESSION_SECRET=""
# -----------------------------------------------------------------------------
# Google Gemini AI Assistant Integration
# -----------------------------------------------------------------------------
# Google AI Studio API Key (Eligible for free tier)
# Read strictly on the server; NEVER expose to client-side code or browser bundles.
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini model identifier (eligible for free tier; default: gemini-3.8-flash)
GEMINI_MODEL=""

# -----------------------------------------------------------------------------
# Gmail SMTP Email Notification Integration (Nodemailer)
# -----------------------------------------------------------------------------
# Sends booking confirmations, quote inquiries, and telemetry alerts via Gmail SMTP.
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Supply your Gmail address and the 16-character App Password below.
# Port: 465 (SSL), Host: smtp.gmail.com, Secure: true
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Optional custom sender display name (defaults to "Slotly <${GMAIL_USER}>")
EMAIL_FROM="Slotly <>"

# Optional admin email for receiving quote inquiries & telemetry incident alerts
ADMIN_NOTIFICATION_EMAIL=""


