# Slotly Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# Do NOT commit actual secrets, API keys, or production credentials to version control.

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Database Configuration (Neon Serverless PostgreSQL with Prisma)
# -----------------------------------------------------------------------------
# 1. DATABASE_URL: Neon Pooled Connection String (Port 5432 or 6543)
#    In the Neon Console: Select your project -> "Connection Details" -> Enable "Pooled connection" checkbox.
#    Format: postgresql://<user>:<password>@<endpoint-id>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/slotly?sslmode=require"

# 2. DIRECT_URL: Neon Direct Connection String (Non-pooled)
#    In the Neon Console: Disable the "Pooled connection" checkbox to get the direct endpoint.
#    Used by Prisma CLI for migrations to acquire database advisory locks without pooler interference.
#    Format: postgresql://<user>:<password>@<endpoint-id>.<region>.aws.neon.tech/<dbname>?sslmode=require
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/slotly?sslmode=require"

# -----------------------------------------------------------------------------
# Admin Authentication & Security
# -----------------------------------------------------------------------------
# Admin email for dashboard authorization
ADMIN_EMAIL="admin@slotly.atelier"

# Secure PBKDF2 password hash (format: salt_hex:hash_hex).
# Generate using: npm run admin:hash
ADMIN_PASSWORD_HASH="salt_hex:hash_hex"

# Cryptographically random 64-character hex string for signing admin session cookies.
# Generate using: openssl rand -hex 32
ADMIN_SESSION_SECRET="your_cryptographically_secure_session_secret_32_bytes_hex"

# -----------------------------------------------------------------------------
# Google Gemini AI Assistant Integration
# -----------------------------------------------------------------------------
# Google AI Studio API Key (Eligible for free tier)
# Read strictly on the server; NEVER expose to client-side code or browser bundles.
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini model identifier (eligible for free tier; default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# -----------------------------------------------------------------------------
# Resend Email Notification Integration (Optional)
# -----------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
# Leave blank or omit until you're ready; booking flow will continue to run smoothly.
RESEND_API_KEY=""

# Sender email address.
# When testing without a custom verified domain in Resend, use "Slotly <onboarding@resend.dev>"
# Once your custom domain is verified in Resend, use e.g. "Slotly Atelier <advisory@yourdomain.com>"
RESEND_FROM_EMAIL="Slotly <onboarding@resend.dev>"

